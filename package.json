{
  "name": "cmux-control",
  "version": "0.4.0",
  "description": "Typed control and cross-session awareness for coding agents running in cmux: workspaces, panes, surfaces, terminals, browser surfaces, and live agent-session discovery",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/wolfiesch/cmux-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfiesch/cmux-control.git"
  },
  "keywords": [
    "cmux",
    "agent-tools",
    "coding-agent",
    "terminal",
    "multiplexer",
    "agents",
    "claude-code",
    "codex",
    "oh-my-pi",
    "omp",
    "pi-extension",
    "pi-coding-agent"
  ],
  "files": [
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.2"
  }
}
